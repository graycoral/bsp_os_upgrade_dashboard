  "exit_codes": {
    "0": "success, already watching, or observation in progress/passed",
    "1": "command, validation, or transport failure",
    "2": "argument syntax error",
    "3": "disconnected, runner changed, or unknown Run",
    "4": "hold or paused Run",
    "5": "failed/cancelled/aborted/superseded Run",
    "6": "NOT_PROVISIONED",
    "130": "interrupted observer"
  },
