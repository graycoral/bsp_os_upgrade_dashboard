    "may_install_dependencies": true,
    "may_download_dependencies": true,
    "disable": "connect --watch --no-provision",
    "read_only_scope": "Windows requests; Linux state and a local owner lock may be written",
    "may_write_local_state": true
  },
  "effects_semantics": "Possible effects after startup, including conditional branches. Most specific matching form wins. hardware includes control of an active or future board operation. Option tables describe parser syntax. Command forms enumerate the supported direct operations. Local state and lock writes during client initialization are included in bootstrap.",
