{
  "schema_version": 1,
  "interface": "plugin.py",
  "contract_version": "2026-11-29.1",
  "long_option_abbreviation": false,
  "global_option_position": "before_command",
  "global_options": {
    "--home": "path",
    "--runtime": "path",
    "--state-dir": "path",
    "--project-root": "path",
    "--project": "string",
    "--port": "int",
    "--monitor-port": "int",
    "--connector-port": "int",
    "--help": "flag",
    "-h": "flag"
  },
  "exit_codes": {
    "0": "success, already watching, or observation in progress/passed",
    "1": "command, validation, or transport failure",
    "2": "argument syntax error",
    "3": "disconnected, runner changed, or unknown Run",
    "4": "hold or paused Run",
    "5": "failed/cancelled/aborted/superseded Run",
    "6": "NOT_PROVISIONED",
    "130": "interrupted observer or activation"
  },
  "bootstrap": {
    "direct_commands": [
      "connect",
      "connector",
      "status",
      "settings",
      "test",
      "modules"
    ],
    "may_install_dependencies": true,
    "may_download_dependencies": true,
    "disable": "connect --watch --no-provision",
    "read_only_scope": "Windows requests; Linux state and a local owner lock may be written",
    "may_write_local_state": true
  },
  "effects_semantics": "Possible effects after startup, including conditional branches. Most specific matching form wins. hardware includes control of an active or future board operation. Option tables describe parser syntax. Command forms enumerate the supported direct operations. Local state and lock writes during client initialization are included in bootstrap.",
