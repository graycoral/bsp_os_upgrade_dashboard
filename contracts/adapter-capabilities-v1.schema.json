{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "module_report_versions": {
      "items": {
        "enum": [
          1,
          2
        ],
        "type": "integer"
      },
      "title": "Module Report Versions",
      "type": "array"
    },
    "orchestration_versions": {
      "items": {
        "const": 1,
        "type": "integer"
      },
      "title": "Orchestration Versions",
      "type": "array"
    },
    "roles": {
