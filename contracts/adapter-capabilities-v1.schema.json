        "enum": [
          "analyst",
          "designer",
          "implementer",
          "builder",
          "reviewer",
          "verifier",
          "integration",
          "orchestrator"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    },
    "command_result_versions": {
      "items": {
        "const": 1,
        "type": "integer"
      },
      "title": "Command Result Versions",
      "type": "array"
    }
