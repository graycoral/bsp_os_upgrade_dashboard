{
  "$defs": {
    "Board": {
      "additionalProperties": false,
      "properties": {
        "board_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Board Id",
          "type": "string"
        },
        "host": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Host",
          "type": "string"
        },
        "com": {
          "pattern": "^COM[1-9][0-9]{0,3}$",
          "title": "Com",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        }
      },
      "required": [
        "board_id",
        "host",
        "com"
      ],
      "title": "Board",
      "type": "object"
    },
    "CommandSnapshotModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/CommandTemplate"
        }
      },
      "required": [
        "revision",
        "template"
      ],
      "title": "CommandSnapshotModel",
      "type": "object"
    },
    "CommandTemplate": {
      "additionalProperties": false,
      "properties": {
        "single": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Single",
          "type": "array"
        },
        "dual": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 4,
          "title": "Dual",
          "type": "array"
        }
      },
      "required": [
        "single",
        "dual"
      ],
      "title": "CommandTemplate",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/Board"
        },
        "b": {
          "anyOf": [
            {
              "$ref": "#/$defs/Board"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "a"
      ],
      "title": "Connection",
      "type": "object"
    },
    "ConnectorRunStepInput": {
      "additionalProperties": false,
      "properties": {
        "step_index": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Step Index",
          "type": "integer"
        },
        "tc_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Tc Id",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "Single",
            "Dual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "effective_timeout_s": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Timeout S"
        },
        "metadata_timeout_s": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Timeout S"
        },
        "parser": {
          "additionalProperties": true,
          "title": "Parser",
          "type": "object"
        },
        "after": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "After",
          "type": "array"
        }
      },
      "required": [
        "step_index",
        "tc_id",
        "path",
        "kind"
      ],
      "title": "ConnectorRunStepInput",
      "type": "object"
    },
    "FailurePolicyModel": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "fail-stop-analysis-v1",
          "default": "fail-stop-analysis-v1",
          "title": "Mode",
          "type": "string"
        },
        "max_retry_chain": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Retry Chain",
          "type": "integer"
        },
        "stop_on_same_cause": {
          "default": true,
          "title": "Stop On Same Cause",
          "type": "boolean"
        },
        "verifier_required": {
          "default": true,
          "title": "Verifier Required",
          "type": "boolean"
        }
      },
      "title": "FailurePolicyModel",
      "type": "object"
    },
    "InstallerSpecModel": {
      "additionalProperties": false,
      "properties": {
        "installer_snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Installer Snapshot Id",
          "type": "string"
        },
        "flash_profile": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Flash Profile",
          "type": "string"
        },
        "flash_profile_revision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Flash Profile Revision",
          "type": "string"
        }
      },
      "required": [
        "installer_snapshot_id",
        "flash_profile",
        "flash_profile_revision"
      ],
      "title": "InstallerSpecModel",
      "type": "object"
    },
    "OriginModel": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "client": {
          "default": "plugin",
          "enum": [
            "plugin",
            "agent_monitor",
            "connector"
          ],
          "title": "Client",
          "type": "string"
        },
        "session_id": {
          "default": "default",
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "title": "OriginModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "request_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Hash"
    },
    "execution_mode": {
      "enum": [
        "flash_and_test",
        "tc_only"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "connection": {
      "$ref": "#/$defs/Connection"
    },
    "source_snapshot_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "source_revision": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "command_snapshot": {
      "$ref": "#/$defs/CommandSnapshotModel"
    },
    "installer": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstallerSpecModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/ConnectorRunStepInput"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "timeout_settings_snapshot": {
      "additionalProperties": true,
      "title": "Timeout Settings Snapshot",
      "type": "object"
    },
    "failure_policy": {
      "$ref": "#/$defs/FailurePolicyModel"
    },
    "origin": {
      "$ref": "#/$defs/OriginModel"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "retry_chain": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Chain"
    }
  },
  "required": [
    "execution_mode",
    "connection",
    "source_snapshot_id",
    "source_revision",
    "command_snapshot",
    "tests"
  ],
  "title": "ConnectorRunRequest",
  "type": "object"
}
